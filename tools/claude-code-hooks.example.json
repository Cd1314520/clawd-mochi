{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 \"http://192.168.137.50/notify?breathe=1\" >/dev/null 2>&1 || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 \"http://192.168.137.50/notify?breathe=0\" >/dev/null 2>&1 || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 \"http://192.168.137.50/notify?alert=bad\" >/dev/null 2>&1 || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 \"http://192.168.137.50/notify?view=s\" >/dev/null 2>&1 || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
